# Environment-variable reference only; this project does not automatically
# load .env files. Prefer entering credentials in the local terminal and never
# commit this file or paste its values into an AI chat.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Used only when the OS keyring is unavailable.
TELEGRAM_MCP_MASTER_KEY=

# Required only for an explicitly enabled SQLCipher cache.
TELEGRAM_MCP_CACHE_KEY=

# Required before the media send tool may read local files.
TELEGRAM_MCP_UPLOAD_DIR=
