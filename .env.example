# Copy this file to .env and fill in your values.
# Get them at https://my.telegram.org -> API development tools
# (Log in with your phone, create an app, copy api_id and api_hash.)

TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Optional: session name (default "default"). Sessions live in ./sessions/
# TELEGRAM_ACCOUNT=default
